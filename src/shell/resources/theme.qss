/* TengWangge SCADA / industrial workbench stylesheet.
 * Token placeholders are expanded from tw::Theme at load time.
 */

QMainWindow { background: @surface@; }
QWidget {
    font-family: @fontFamily@;
    font-size: @fontSize@px;
    color: @text@;
}
QToolTip {
    background: @panel@; color: @text@;
    border: 1px solid @border@; padding: 4px 8px;
}

/* ---------- unified 68px top ribbon bar ---------- */
QFrame#topBar {
    background: @chrome@;
    border: none;
    border-bottom: 1px solid @chromeBorder@;
}
QFrame#topBar QLabel { background: transparent; }
QListWidget#toolRail {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#toolRail:disabled { background: transparent; }

QToolButton#topActionBtn {
    background: transparent;
    color: @chromeText@;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 2px 2px 2px;
    font-size: 12px;
}
QToolButton#topActionBtn:hover {
    background: @chromeHover@;
    border-color: @borderSoft@;
}
QToolButton#topActionBtn:checked {
    background: @chromeSelected@;
    border-color: @chromeSelectedBorder@;
    font-weight: 600;
}
QToolButton#topActionBtn:disabled {
    color: @chromeDisabled@;
}
QFrame#topDivider {
    background: @chromeBorder@;
    border: none;
    max-width: 1px;
    min-width: 1px;
}
QToolButton#moreToolsBtn {
    background: @panel@;
    color: @textMuted@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 0 4px;
    font-size: 12px;
}
QToolButton#moreToolsBtn:hover {
    background: @chromeHover@;
    border-color: @primary@;
    color: @primary@;
}
QPushButton#quickSearchBtn {
    background: @panel@;
    color: @textMuted@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 4px 10px;
    min-height: 24px;
    font-size: 12px;
    text-align: left;
}
QPushButton#quickSearchBtn:hover {
    border-color: @primary@;
    color: @text@;
    background: @panel@;
}
QPushButton#quickSearchBtn:disabled {
    color: @disabledText@;
    background: @panelAlt@;
}

/* ---------- tool hub (20+ tools category card grid) ---------- */
QWidget#toolHubView, QScrollArea#hubScrollArea, QWidget#hubGridHost {
    background: @surface@;
    border: none;
}
QFrame#toolHubCard {
    background: @panel@;
    border: 1px solid @border@;
    border-radius: 6px;
}
QFrame#toolHubCard:hover {
    background: @selectionSoft@;
    border-color: @primary@;
}
QFrame#toolHubCard QLabel { background: transparent; }
QLabel#hubCardTitle { font-size: 14px; font-weight: 700; color: @text@; }
QLabel#hubCardTag {
    background: @chromeSelected@;
    color: @primary@;
    border: 1px solid @chromeSelectedBorder@;
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 11px;
}
QLabel#hubCardTagErr {
    background: @dangerSoft@;
    color: @danger@;
    border: 1px solid @danger@;
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 11px;
}
QLabel#hubCardSummary { color: @textMuted@; font-size: 12px; }
QLabel#hubCardId { color: @disabledText@; font-family: @monoFamily@; font-size: 11px; }

/* ---------- Ctrl+K quick launcher ---------- */
QDialog#quickLauncher { background: @surface@; }
QLineEdit#quickLauncherInput {
    background: @panel@;
    border: 1px solid @primary@;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}
QListWidget#quickLauncherList {
    background: @panel@;
    border: 1px solid @border@;
    border-radius: 4px;
    outline: none;
}
QListWidget#quickLauncherList::item { padding: 4px 8px; }
QListWidget#quickLauncherList::item:selected {
    background: @primary@;
    color: @panel@;
}

/* ---------- compact sub-page tab strip (auto-hidden for 1-page tools) ---------- */
QWidget#toolView, QStackedWidget#toolStack, QScrollArea#pageScrollArea, QWidget#pageScrollViewport {
    background: @surface@;
    border: none;
}
QFrame#pageStrip {
    background: @chromeRaised@;
    border: none;
    border-bottom: 1px solid @border@;
}
QTabBar#pageTabs { background: transparent; border: none; }
QTabBar#pageTabs::tab {
    background: @panelAlt@;
    color: @textMuted@;
    border: 1px solid @border@;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 4px 16px;
    margin: 4px 4px 0 0;
    min-width: 64px;
    font-size: 12px;
}
QTabBar#pageTabs::tab:hover:!selected {
    background: @panel@;
    color: @text@;
    border-color: @chromeSelectedBorder@;
}
QTabBar#pageTabs::tab:selected {
    background: @panel@;
    color: @primary@;
    border: 1px solid @border@;
    border-top: 2px solid @primary@;
    border-bottom: 1px solid @panel@;
    font-weight: 600;
}
QTabBar#pageTabs[tabFocus="true"]::tab:selected {
    border-top: 2px solid @accent@;
}
QTabBar#pageTabs::tab:disabled { color: @disabledText@; background: @panelAlt@; }
QTabBar#pageTabs::tab:selected:disabled {
    color: @textMuted@; background: @borderSoft@; border-color: @border@;
}
QTabBar#pageTabs QToolButton { background: @panelAlt@; border: 1px solid @border@; }

/* ---------- unavailable / empty ---------- */
QWidget#unavailableView, QWidget#emptyView { background: @surface@; }
QLabel#unavailableTitle { color: @danger@; font-size: 16px; font-weight: 700; }
QLabel#unavailableReason { color: @textMuted@; }
QLabel#emptyTitle { color: @textMuted@; font-size: 15px; font-weight: 600; }

/* ---------- splitters (horizontal & vertical 5-dot handles) ---------- */
QSplitter::handle:vertical { background: @surface@; height: 6px; }
QSplitter::handle:horizontal { background: @surface@; width: 6px; }
QSplitter::handle:hover { background: @chromeHover@; }

/* ---------- frameless-header bottom message log box ---------- */
QFrame#logPanel {
    background: @surface@;
    border: none;
}
QFrame#logHeader {
    background: @panelAlt@;
    border: 1px solid @border@;
    border-bottom: none;
}
QLabel#logTitle { font-weight: 600; font-size: 12px; color: @text@; background: transparent; }
QFrame#logHeader QLineEdit#logSearch { padding: 1px 6px; min-height: 18px; font-size: 12px; }
QFrame#logHeader QComboBox#logLevelFilter { padding: 1px 8px; min-height: 18px; font-size: 12px; }
QFrame#logHeader QPushButton { padding: 1px 8px; min-height: 18px; font-size: 12px; }
QPlainTextEdit#logView {
    background: @panel@;
    border: 1px solid @border@;
    font-family: @monoFamily@;
    font-size: 12px;
    padding: 3px 6px;
}
QCheckBox#logShowAll { background: transparent; color: @textMuted@; font-size: 12px; }

/* ---------- light gray bottom status bar ---------- */
QStatusBar {
    background: @chromeRaised@;
    color: @chromeText@;
    border: none;
    border-top: 1px solid @chromeBorder@;
}
QStatusBar::item { border: none; }
QFrame#statusStrip { background: transparent; }
QFrame#statusStrip QLabel { background: transparent; }
QLabel#statusDot { border-radius: 4px; background: @statusIdle@; }
QLabel#statusDot[state="idle"] { background: @statusIdle@; }
QLabel#statusDot[state="info"] { background: @statusInfo@; }
QLabel#statusDot[state="busy"] { background: @statusBusy@; }
QLabel#statusDot[state="success"] { background: @statusSuccess@; }
QLabel#statusDot[state="error"] { background: @statusError@; }
QLabel#statusText { color: @statusIdle@; font-size: 12px; }
QLabel#statusText[state="idle"] { color: @statusIdle@; }
QLabel#statusText[state="info"] { color: @statusInfo@; }
QLabel#statusText[state="busy"] { color: @statusBusy@; font-weight: 600; }
QLabel#statusText[state="success"] { color: @statusSuccess@; font-weight: 600; }
QLabel#statusText[state="error"] { color: @statusError@; font-weight: 700; }
QFrame#statusStrip QLabel#statusLockChip {
    background: @lockBg@; color: @lockText@;
    border: 1px solid @lockBorder@;
    border-radius: 3px; padding: 0 8px; font-size: 12px; font-weight: 600;
}
QLabel#statusMeta {
    color: @text@; font-size: 12px; padding: 0 6px;
}
QPushButton#logToggle {
    background: @panel@; color: @textMuted@;
    border: 1px solid @border@; border-radius: 3px;
    padding: 0 8px; min-height: 18px; font-size: 11px;
}
QPushButton#logToggle:hover { background: @chromeHover@; border-color: @primary@; color: @text@; }
QPushButton#logToggle:checked {
    background: @chromeSelected@; color: @primary@; border-color: @chromeSelectedBorder@; font-weight: 600;
}
QPushButton#logToggle:focus { border-color: @primary@; }

/* ---------- industrial workspace roles & controls ---------- */
QLabel[role="paneTitle"] { font-size: 12px; color: @text@; padding: 0 1px 2px 1px; }
QLabel[role="pageTitle"] { font-size: 15px; font-weight: 700; color: @text@; }
QLabel[role="pageSubtitle"] { color: @textMuted@; font-size: 12px; }
QLabel[role="sectionTitle"] { font-size: 13px; font-weight: 600; color: @text@; }
QLabel[role="fieldLabel"] { color: @text@; font-weight: 600; }
QLabel[role="hint"] { color: @textMuted@; font-size: 12px; }
QLabel[role="value"] { font-family: @monoFamily@; color: @text@; }
QLabel[role="code"] { font-family: @monoFamily@; color: @primary@; }
QLabel[role="pill"], QFrame[role="card"] QLabel[role="pill"] {
    background: @teal@; color: @panel@;
    border-radius: 3px; padding: 2px 8px; font-size: 12px; font-weight: 600;
}
QLabel[role="pillDanger"], QFrame[role="card"] QLabel[role="pillDanger"] {
    background: @danger@; color: @panel@;
    border-radius: 3px; padding: 2px 8px; font-size: 12px; font-weight: 600;
}

/* ---------- compare summary KPI strip ---------- */
QFrame#summaryBar {
    background: @panel@;
    border: 1px solid @borderSoft@;
    border-radius: 4px;
}
QFrame#summaryBar QLabel[role="hint"] { background: transparent; }
QLabel[role="statTotal"] {
    background: @chromeRaised@; color: @text@;
    border: 1px solid @border@; border-radius: 3px;
    padding: 1px 7px; font-size: 12px; font-weight: 600;
}
QLabel[role="statSame"] {
    background: #eaf7ef; color: @statusSuccess@;
    border: 1px solid #b7e4c7; border-radius: 3px;
    padding: 1px 7px; font-size: 12px; font-weight: 600;
}
QLabel[role="statDiff"] {
    background: @dangerSoft@; color: @danger@;
    border: 1px solid #f5c2c0; border-radius: 3px;
    padding: 1px 7px; font-size: 12px; font-weight: 600;
}
QLabel[role="statLeft"] {
    background: @selectionSoft@; color: @primary@;
    border: 1px solid @chromeSelectedBorder@; border-radius: 3px;
    padding: 1px 7px; font-size: 12px; font-weight: 600;
}
QLabel[role="statRight"] {
    background: @lockBg@; color: @lockText@;
    border: 1px solid @lockBorder@; border-radius: 3px;
    padding: 1px 7px; font-size: 12px; font-weight: 600;
}
QLabel[role="statMd5Ok"] {
    background: #eaf7ef; color: @statusSuccess@;
    border: 1px solid #b7e4c7; border-radius: 3px;
    padding: 1px 7px; font-family: @monoFamily@; font-size: 11px; font-weight: 600;
}
QLabel[role="statMd5Diff"] {
    background: @dangerSoft@; color: @danger@;
    border: 1px solid #f5c2c0; border-radius: 3px;
    padding: 1px 7px; font-family: @monoFamily@; font-size: 11px; font-weight: 600;
}

QFrame[role="card"] {
    background: @panel@; border: 1px solid @border@; border-radius: 2px;
}
QFrame[role="card"] QLabel { background: transparent; }
QFrame[role="toolbar"] {
    background: transparent; border: none;
}
QFrame[role="tableHeader"] {
    background: @panelAlt@; border: none; border-bottom: 1px solid @border@;
}
QFrame[role="tableRow"] {
    background: @panel@; border: none; border-bottom: 1px solid @borderSoft@;
}
QFrame[role="tableRowAlt"] {
    background: @panelAlt@; border: none; border-bottom: 1px solid @borderSoft@;
}

QTableWidget, QTreeWidget {
    background: @panel@;
    border: 1px solid @border@;
    gridline-color: @borderSoft@;
    selection-background-color: @primary@;
    selection-color: @panel@;
    outline: none;
}
QTreeWidget::item { height: 24px; padding: 1px 4px; }
QTreeWidget::item:selected, QTableWidget::item:selected {
    background: @primary@; color: @panel@;
}
QTreeWidget::item:hover:!selected { background: @chromeHover@; }
QHeaderView::section {
    background: @panelAlt@; color: @text@; font-weight: 500;
    border: none; border-right: 1px solid @borderSoft@; border-bottom: 1px solid @border@;
    padding: 4px 8px; font-size: 12px;
}

QPushButton {
    background: @panel@; color: @text@;
    border: 1px solid @border@; border-radius: 4px;
    padding: 3px 11px; min-height: 20px; font-size: 12px;
}
QPushButton:hover { background: @chromeHover@; border-color: @chromeSelectedBorder@; }
QPushButton:pressed { background: @chromeSelected@; }
QPushButton:checked {
    background: @chromeSelected@;
    color: @primary@;
    border-color: @chromeSelectedBorder@;
    font-weight: 600;
}
QPushButton:focus { border: 1px solid @primary@; }
QPushButton:disabled { color: @disabledText@; background: @panelAlt@; border-color: @borderSoft@; }
QPushButton[role="primary"] {
    background: @panel@; color: @text@; border-color: @border@;
}
QPushButton[role="primary"]:hover { background: @chromeHover@; border-color: @primary@; }
QPushButton[role="teal"] {
    background: @teal@; color: @panel@; border-color: @teal@; font-weight: 600;
}
QPushButton[role="danger"] { color: @text@; border-color: @border@; background: @panel@; }
QPushButton[role="danger"]:hover { background: @dangerSoft@; border-color: @danger@; color: @danger@; }

QLineEdit, QSpinBox, QComboBox, QTextEdit {
    background: @panel@; border: 1px solid @border@; border-radius: 3px;
    padding: 3px 6px; min-height: 20px; font-size: 12px;
    selection-background-color: @primary@; selection-color: @panel@;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid @primary@; }
QLineEdit:disabled, QSpinBox:disabled { color: @disabledText@; background: @panelAlt@; }
QCheckBox { spacing: 6px; font-size: 12px; }
QCheckBox:disabled { color: @disabledText@; }
QProgressBar {
    border: 1px solid @border@; border-radius: 3px; background: @panelAlt@;
    text-align: center; color: @text@; min-height: 14px; max-height: 14px;
}
QProgressBar::chunk { background: @primary@; border-radius: 2px; }

QScrollBar:vertical { background: @panelAlt@; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @border@; min-height: 28px; border-radius: 4px; margin: 1px; }
QScrollBar::handle:vertical:hover { background: @disabledText@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: @panelAlt@; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: @border@; min-width: 28px; border-radius: 4px; margin: 1px; }
QScrollBar::handle:horizontal:hover { background: @disabledText@; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QDialog, QMessageBox { background: @surface@; }
